<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">
    <PreferenceCategory app:title="@string/cat_access" app:iconSpaceReserved="false">
        <SwitchPreferenceCompat app:key="app_lock" app:defaultValue="false" app:title="@string/pref_app_lock" app:summary="@string/pref_app_lock_sum" app:iconSpaceReserved="false" />
        <ListPreference app:key="lock_timeout" app:dependency="app_lock" app:defaultValue="3" app:entries="@array/lock_timeout_names" app:entryValues="@array/lock_timeout_values" app:title="@string/pref_lock_timeout" app:useSimpleSummaryProvider="true" app:iconSpaceReserved="false" />
    </PreferenceCategory>
    <PreferenceCategory app:title="@string/cat_protection" app:iconSpaceReserved="false">
        <ListPreference app:key="tracker_level" app:defaultValue="standard" app:entries="@array/tracker_level_names" app:entryValues="@array/tracker_level_values" app:title="@string/pref_tracker_level" app:useSimpleSummaryProvider="true" app:iconSpaceReserved="false" />
        <Preference app:key="site_exceptions" app:title="@string/pref_site_exceptions" app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat app:key="https_first" app:defaultValue="true" app:title="@string/pref_https_first" app:summary="@string/pref_https_first_sum" app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat app:key="block_third_party" app:defaultValue="true" app:title="@string/pref_third_party" app:summary="@string/pref_third_party_sum" app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat app:key="send_dnt" app:defaultValue="true" app:title="@string/pref_dnt" app:summary="@string/pref_dnt_sum" app:iconSpaceReserved="false" />
    </PreferenceCategory>
    <PreferenceCategory app:title="@string/cat_data" app:iconSpaceReserved="false">
        <SwitchPreferenceCompat app:key="save_history" app:defaultValue="true" app:title="@string/pref_save_history" app:summary="@string/pref_save_history_sum" app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat app:key="clear_on_exit" app:defaultValue="false" app:title="@string/pref_clear_exit" app:summary="@string/pref_clear_exit_sum" app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat app:key="hide_preview" app:defaultValue="false" app:title="@string/pref_hide_preview" app:summary="@string/pref_hide_preview_sum" app:iconSpaceReserved="false" />
        <Preference app:key="clear_now" app:title="@string/pref_clear_now" app:summary="@string/pref_clear_now_sum" app:iconSpaceReserved="false" />
    </PreferenceCategory>
</PreferenceScreen>
