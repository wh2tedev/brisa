<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">
    <PreferenceCategory app:title="@string/cat_downloads" app:iconSpaceReserved="false">
        <Preference app:key="download_location" app:title="@string/pref_dl_location" app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat app:key="confirm_downloads" app:defaultValue="true" app:title="@string/pref_dl_confirm" app:summary="@string/pref_dl_confirm_sum" app:iconSpaceReserved="false" />
        <Preference app:key="open_downloads_list" app:title="@string/pref_dl_open" app:iconSpaceReserved="false" />
    </PreferenceCategory>
</PreferenceScreen>
