<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/toolbar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="4dp"
        android:paddingVertical="8dp">

        <EditText
            android:id="@+id/urlBar"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_omnibox"
            android:hint="@string/url_hint"
            android:importantForAutofill="no"
            android:imeOptions="actionGo"
            android:inputType="textUri"
            android:maxLines="1"
            android:paddingHorizontal="18dp"
            android:selectAllOnFocus="true"
            android:textColor="@color/on_bg"
            android:textColorHint="@color/muted"
            android:textCursorDrawable="@null"
            android:textSize="15sp" />

        <FrameLayout
            android:id="@+id/tabsButton"
            style="@style/IconButton"
            android:clickable="true"
            android:contentDescription="@string/tabs"
            android:focusable="true">

            <TextView
                android:id="@+id/tabCount"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_tab_count"
                android:gravity="center"
                android:text="1"
                android:textColor="@color/on_bg"
                android:textSize="12sp"
                android:textStyle="bold" />
        </FrameLayout>

        <ImageButton
            android:id="@+id/menu"
            style="@style/IconButton"
            android:contentDescription="@string/more"
            android:src="@drawable/ic_more_vert" />
    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:indicatorColor="@color/accent"
        app:trackColor="@color/toolbar"
        app:trackThickness="2dp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:id="@+id/webContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/home"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:text="@string/app_name"
                android:textColor="@color/on_bg"
                android:textSize="48sp" />

            <TextView
                android:id="@+id/homeSearch"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_home_search"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingHorizontal="20dp"
                android:text="@string/url_hint"
                android:textColor="@color/muted"
                android:textSize="15sp" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/findBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/toolbar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="4dp"
        android:visibility="gone">

        <EditText
            android:id="@+id/findInput"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/find_hint"
            android:importantForAutofill="no"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/on_bg"
            android:textColorHint="@color/muted"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/findCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <ImageButton
            android:id="@+id/findPrev"
            style="@style/IconButton"
            android:contentDescription="@string/find_previous"
            android:src="@drawable/ic_arrow_up" />

        <ImageButton
            android:id="@+id/findNext"
            style="@style/IconButton"
            android:contentDescription="@string/find_next"
            android:src="@drawable/ic_arrow_down" />

        <ImageButton
            android:id="@+id/findClose"
            style="@style/IconButton"
            android:contentDescription="@string/close"
            android:src="@drawable/ic_close" />
    </LinearLayout>
</LinearLayout>

    <FrameLayout
        android:id="@+id/fullscreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone" />
</FrameLayout>
