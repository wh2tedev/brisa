<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/brisaToolbar">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/brisaToolbar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="4dp"
            android:paddingVertical="9dp">

            <LinearLayout
                android:id="@+id/omnibox"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@drawable/bg_omnibox"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/siteIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="14dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_search"
                    app:tint="?attr/brisaMuted" />

                <EditText
                    android:id="@+id/urlBar"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/url_hint"
                                        android:importantForAutofill="no"
                    android:imeOptions="actionGo"
                    android:inputType="textUri"
                    android:maxLines="1"
                    android:paddingStart="10dp"
                    android:paddingEnd="6dp"
                    android:selectAllOnFocus="true"
                    android:textColor="?attr/brisaOnBg"
                    android:textColorHint="?attr/brisaMuted"
                    android:textSize="15sp" />

                <ImageButton
                    android:id="@+id/clearUrl"
                    style="@style/IconButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="@string/clear"
                    android:padding="10dp"
                    android:src="@drawable/ic_close"
                    android:tint="?attr/brisaMuted"
                    android:visibility="gone" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/tabsButton"
                style="@style/IconButton"
                android:clickable="true"
                android:contentDescription="@string/tabs"
                android:focusable="true">

                <TextView
                    android:id="@+id/tabCount"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_tab_count"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="?attr/brisaOnBg"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <ImageButton
                android:id="@+id/menu"
                style="@style/IconButton"
                android:contentDescription="@string/more"
                android:src="@drawable/ic_more_vert" />
        </LinearLayout>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:indicatorColor="?attr/brisaAccent"
            app:trackCornerRadius="2dp"
            app:trackThickness="3dp"
            app:trackColor="?attr/brisaToolbar" />

        <FrameLayout
            android:id="@+id/webFrame"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="?attr/brisaBg">

            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/swipe"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <FrameLayout
                    android:id="@+id/webContainer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

            <LinearLayout
                android:id="@+id/suggestions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:background="?attr/brisaPopup"
                android:elevation="8dp"
                android:orientation="vertical"
                android:paddingVertical="4dp"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/findBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/brisaToolbar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="4dp"
            android:visibility="gone">

            <EditText
                android:id="@+id/findInput"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/find_hint"
                android:importantForAutofill="no"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="?attr/brisaOnBg"
                android:textColorHint="?attr/brisaMuted"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/findCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:textColor="?attr/brisaMuted"
                android:textSize="13sp" />

            <ImageButton
                android:id="@+id/findPrev"
                style="@style/IconButton"
                android:contentDescription="@string/find_previous"
                android:src="@drawable/ic_arrow_up" />

            <ImageButton
                android:id="@+id/findNext"
                style="@style/IconButton"
                android:contentDescription="@string/find_next"
                android:src="@drawable/ic_arrow_down" />

            <ImageButton
                android:id="@+id/findClose"
                style="@style/IconButton"
                android:contentDescription="@string/close"
                android:src="@drawable/ic_close" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/fullscreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone" />
</FrameLayout>
