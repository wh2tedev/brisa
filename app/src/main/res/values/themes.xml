<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Brisa" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="brisaBg">@color/bg</item>
        <item name="brisaToolbar">@color/toolbar</item>
        <item name="brisaField">@color/field</item>
        <item name="brisaPopup">@color/popup</item>
        <item name="brisaDivider">@color/divider</item>
        <item name="brisaOnBg">@color/on_bg</item>
        <item name="brisaMuted">@color/muted</item>
        <item name="brisaAccent">@color/accent_blue</item>
        <item name="brisaOnAccent">@color/accent_on</item>
        <item name="brisaWarning">@color/warning</item>
        <item name="colorPrimary">@color/accent_blue</item>
        <item name="colorOnPrimary">@color/accent_on</item>
        <item name="colorSurface">@color/bg</item>
        <item name="colorOnSurface">@color/on_bg</item>
        <item name="colorOnSurfaceVariant">@color/muted</item>
        <item name="colorSurfaceContainer">@color/toolbar</item>
        <item name="colorSurfaceContainerHigh">@color/popup</item>
        <item name="colorSecondaryContainer">@color/field</item>
        <item name="colorOnSecondaryContainer">@color/on_bg</item>
        <item name="colorOutlineVariant">@color/divider</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="bottomSheetDialogTheme">@style/BrisaSheetDialog</item>
    </style>

    <style name="ThemeOverlay.Brisa.Amoled" parent="">
        <item name="brisaBg">@color/amoled_bg</item>
        <item name="brisaToolbar">@color/amoled_toolbar</item>
        <item name="brisaField">@color/amoled_field</item>
        <item name="brisaPopup">@color/amoled_popup</item>
        <item name="brisaDivider">@color/amoled_divider</item>
        <item name="colorSurface">@color/amoled_bg</item>
        <item name="colorSurfaceContainer">@color/amoled_toolbar</item>
        <item name="colorSurfaceContainerHigh">@color/amoled_popup</item>
        <item name="colorSecondaryContainer">@color/amoled_field</item>
        <item name="android:colorBackground">@color/amoled_bg</item>
        <item name="android:windowBackground">@color/amoled_bg</item>
    </style>

    <style name="Accent.Blue" parent=""><item name="brisaAccent">@color/accent_blue</item><item name="colorPrimary">@color/accent_blue</item></style>
    <style name="Accent.Green" parent=""><item name="brisaAccent">@color/accent_green</item><item name="colorPrimary">@color/accent_green</item></style>
    <style name="Accent.Purple" parent=""><item name="brisaAccent">@color/accent_purple</item><item name="colorPrimary">@color/accent_purple</item></style>
    <style name="Accent.Orange" parent=""><item name="brisaAccent">@color/accent_orange</item><item name="colorPrimary">@color/accent_orange</item></style>
    <style name="Accent.Pink" parent=""><item name="brisaAccent">@color/accent_pink</item><item name="colorPrimary">@color/accent_pink</item></style>
    <style name="Accent.Teal" parent=""><item name="brisaAccent">@color/accent_teal</item><item name="colorPrimary">@color/accent_teal</item></style>
    <style name="Accent.Red" parent=""><item name="brisaAccent">@color/accent_red</item><item name="colorPrimary">@color/accent_red</item></style>

    <style name="BrisaSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/BrisaSheet</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="BrisaSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">?attr/brisaPopup</item>
    </style>

    <style name="IconButton">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:tint">?attr/brisaOnBg</item>
    </style>

    <style name="MenuRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingHorizontal">18dp</item>
        <item name="android:drawablePadding">16dp</item>
        <item name="android:drawableTint">?attr/brisaMuted</item>
        <item name="android:textColor">?attr/brisaOnBg</item>
        <item name="android:textSize">15sp</item>
    </style>
</resources>
